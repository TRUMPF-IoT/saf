{
  "PluginAssemblies": {
    "SearchRootPath": ".",
    "Recursive": false,
    "IncludePatterns": "SAF.Services.*.dll;SAF.Messaging.Nats.dll;SAF.Messaging.Runtime.dll",
    "ExcludePatterns": "Microsoft.*;System.*;Serilog.*;SAF.PluginSystem.*;*.Tests.dll"
  },
  "PluginSystem": {
    "PluginSettingsRootPath": ".",
    "PluginSettingsFilePath": "./appsettings.json",
    "PluginContractsSearchPattern": "SAF.Common.dll;SAF.Messaging.Contracts.dll"
  },
  "ServiceHost": {
    "ServiceHostType": "Nats",
    "FileSystemUserBasePath": "tempfs"
  },
  "Messaging": {
    "PrimaryKey": "Nats"
  },
  "Nats": {
    "Url": "nats://localhost:4222"
  },
  "Logging": {
    "Console": {
      "IncludeScopes": false,
      "LogLevel": {
        "TestRunnerConsole.TestMessagingInfrastructure": "Debug",
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Debug"
    }
  }
}


{
  "PluginAssemblies": {
    "SearchRootPath": ".",
    "Recursive": false,
    "IncludePatterns": "SAF.Services.*.dll;SAF.Messaging.Redis.dll;SAF.Messaging.Runtime.dll",
    "ExcludePatterns": "Microsoft.*;System.*;Serilog.*;SAF.PluginSystem.*;*.Tests.dll"
  },
  "PluginSystem": {
    "PluginSettingsRootPath": ".",
    "PluginSettingsFilePath": "./appsettings.json"
  },
  "ServiceHost": {
    "ServiceHostType": "Redis",
    "FileSystemUserBasePath": "tempfs"
  },
  "Messaging": {
    "PrimaryKey": "Redis"
  },
  "Redis": {
    "ConnectionString": "localhost",
    "Timeout": 60000
  },
  "Logging": {
    "Console": {
      "IncludeScopes": false,
      "LogLevel": {
        "TestRunnerConsole.TestMessagingInfrastructure": "Debug",
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Debug"
    }
  }
}


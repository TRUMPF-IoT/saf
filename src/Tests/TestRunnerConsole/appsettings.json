{
  "PluginAssemblies": {
    "SearchRootPath": ".",
    "Recursive": false,
    "IncludePatterns": "SAF.Services.*.dll;SAF.Messaging.InProcess.dll;SAF.Messaging.Runtime.dll",
    "ExcludePatterns": "Microsoft.*;System.*;Serilog.*;SAF.PluginSystem.*;*.Tests.dll"
  },
  "PluginSystem": {
    "PluginSettingsRootPath": ".",
    "PluginSettingsFilePath": "./appsettings.json"
  },
  "ServiceHost": {
    "ServiceHostType": "InProcess",
    "FileSystemUserBasePath": "tempfs",
    "EnableDiagnostics": true
  },
  "Messaging": {
    "PrimaryKey": "InProcess"
  },
  "Logging": {
    "Console": {
      "IncludeScopes": false,
      "LogLevel": {
        "TestRunnerConsole.TestMessagingInfrastructure": "Debug",
        "Default": "Debug"
      }
    },
    "LogLevel": {
      "Default": "Debug"
    }
  },
  "MySpecialService": {
    "MyStringSetting": "value",
    "MyNumericSetting": 555
  }
}
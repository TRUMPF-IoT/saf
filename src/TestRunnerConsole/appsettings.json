{
  "PluginAssemblies": {
    "SearchRootPath": "../../../../Services",
    "Recursive": true,
    "IncludePatterns": "**/bin/Debug/net10.0/SAF.Services.*.dll",
    "ExcludePatterns": "Microsoft.*;System.*;Serilog.*;SAF.PluginSystem.*;**/SAF.Services.*.Tests.dll"
  },
  "Logging": {
    "Console": {
      "IncludeScopes": false,
      "LogLevel": {
        "TestRunnerConsole.TestMessagingInfrastructure": "Debug",
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Debug"
    }
  }
}
